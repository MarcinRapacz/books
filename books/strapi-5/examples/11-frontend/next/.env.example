# Server only: internal URL of Strapi and a Custom API token (find/findOne on articles and categories)
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=replace-with-api-token
# Same value as WEBHOOK_SECRET in Strapi (webhooks.defaultHeaders, chapter 8)
STRAPI_WEBHOOK_SECRET=replace-with-random-string
# Same value as PREVIEW_SECRET in Strapi (config/admin.ts preview handler, chapter 8)
PREVIEW_SECRET=replace-with-random-string
# Public URL of Strapi, used by the browser (comments)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# true only when Strapi resolves to localhost or a private network (local dev, same Docker network)
STRAPI_IMAGES_LOCAL=true
